# API ключи
OPENAI_API_KEY=

# Настройки логирования
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Whisper настройки
WHISPER_DEVICE=mps  # cpu, cuda, mps

# OpenAI Translation настройки
OPENAI_TRANSLATION_MODEL=gpt-4o-mini  # gpt-4o-mini, gpt-4o, gpt-4, gpt-3.5-turbo

# Пути (опционально, по умолчанию используются относительные)
# OUTPUT_DIR=./output
# TEMP_DIR=./temp
# LOGS_DIR=./logs